{
  "name": "@beeblock/svelar-datatable",
  "version": "0.1.3",
  "description": "Full-featured DataTable plugin for Svelar — sorting, searching, pagination, inline editing, export, and server-side processing",
  "type": "module",
  "keywords": [
    "svelar-plugin",
    "datatable",
    "svelte",
    "sveltekit",
    "data-grid"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./ui": "./src/ui/index.ts",
    "./ui/*": "./src/ui/*"
  },
  "files": [
    "dist",
    "src/ui",
    "src/publishable",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && (tsc --emitDeclarationOnly || echo 'Warning: tsc declaration emit had errors')",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@beeblock/svelar": ">=0.4.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "@beeblock/svelar": {
      "optional": false
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "svelte": "^5.0.0"
  }
}
