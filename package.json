{
  "name": "@beeblock/svelar-datatable",
  "version": "0.2.0",
  "description": "Full-featured DataTable plugin for Svelar — sorting, searching, pagination, inline editing, export, and server-side processing",
  "type": "module",
  "keywords": [
    "svelar-plugin",
    "datatable",
    "svelte",
    "sveltekit",
    "data-grid"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./src/ui/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "svelte": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./ui/*": {
      "svelte": "./src/ui/*",
      "import": "./src/ui/*"
    }
  },
  "files": [
    "dist",
    "src/ui",
    "src/state",
    "src/export",
    "src/types.ts",
    "src/index.ts",
    "src/publishable",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "@beeblock/svelar": "^0.8.0",
    "exceljs": ">=4.4.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "@beeblock/svelar": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cookie": "^1.1.1",
    "esbuild": "^0.28.2",
    "joi": "^18.2.9",
    "svelte": "^5.57.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
